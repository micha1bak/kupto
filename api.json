{
  "openapi": "3.1.0",
  "info": {
    "title": "Kupto",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/api/register": {
      "post": {
        "summary": "Rejestracja użytkownika",
        "description": "Tworzy nowe konto użytkownika i haszuje hasło.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthUser"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Użytkownik zarejestrowany pomyślnie.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "User created successfully." }
                  }
                }
              }
            }
          },
          "409": { "description": "Login jest już zajęty." },
          "400": { "description": "Błąd walidacji danych." }
        }
      }
    },
    "/api/login": {
      "post": {
        "summary": "Logowanie użytkownika",
        "description": "Weryfikuje poświadczenia i ustawia ciasteczko autoryzacyjne HTTP-only (jwt).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthUser"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Zalogowano pomyślnie.",
            "headers": {
              "Set-Cookie": {
                "description": "Ciasteczko zawierające token JWT (HttpOnly, Secure, SameSite=Strict).",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "User logged in successfully." }
                  }
                }
              }
            }
          },
          "401": { "description": "Błędne poświadczenia." },
          "400": { "description": "Błąd walidacji danych." }
        }
      }
    },
    "/api/list": {
      "get": {
        "summary": "Pobranie listy zakupów",
        "description": "Zwraca produkty z domyślnej listy użytkownika pogrupowane według kategorii. Wymaga ciasteczka 'jwt'.",
        "responses": {
          "200": {
            "description": "Lista produktów pogrupowana tematycznie.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "category": { "type": "string", "example": "Nabiał" },
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": { "type": "integer", "example": 101 },
                            "name": { "type": "string", "example": "Mleko" },
                            "quantity": { "type": "string", "example": "2 szt", "nullable": true }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Brak autoryzacji lub wygasła sesja." },
          "500": { "description": "Wewnętrzny błąd serwera." }
        }
      },
      "post": {
        "summary": "Utworzenie nowej listy",
        "description": "Tworzy nową listę zakupów dla zalogowanego użytkownika. Wymaga ciasteczka autoryzacyjnego 'jwt'.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "example": "Lista na weekend"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lista została utworzona.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "list_id": { "type": "integer", "example": 10 },
                    "owner_id": { "type": "integer", "example": 1 },
                    "name": { "type": "string", "example": "Lista na weekend" }
                  }
                }
              }
            }
          },
          "401": { "description": "Brak autoryzacji lub nieprawidłowy token." },
          "400": { "description": "Błędne dane wejściowe (np. pusta nazwa)." },
          "500": { "description": "Wewnętrzny błąd serwera." }
        }
      }
    },
    "/api/list/item": {
      "post": {
        "summary": "Dodanie produktu do listy",
        "description": "Dodaje nowy produkt do domyślnej listy użytkownika lub aktualizuje jego ilość, jeśli już istnieje.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["productId", "quantity"],
                "properties": {
                  "productId": { "type": "integer", "example": 101 },
                  "quantity": { "type": "string", "example": "2 szt" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Produkt dodany/zaktualizowany.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "list_id": { "type": "integer" },
                    "product_id": { "type": "integer" },
                    "quantity": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Brak autoryzacji." },
          "400": { "description": "Błędne dane (np. nieistniejący produkt)." },
          "500": { "description": "Wewnętrzny błąd serwera." }
        }
      }
    },
    "/api/list/item/{productId}": {
      "delete": {
        "summary": "Usunięcie produktu z listy",
        "description": "Usuwa produkt z domyślnej listy zalogowanego użytkownika.",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "description": "ID produktu do usunięcia",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Produkt został usunięty.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "list_id": { "type": "integer" },
                    "product_id": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": { "description": "Nieprawidłowe ID produktu." },
          "401": { "description": "Brak autoryzacji." },
          "500": { "description": "Wewnętrzny błąd serwera." }
        }
      }
    },
    "/api/products": {
      "get": {
        "summary": "Pobranie katalogu produktów",
        "description": "Zwraca listę wszystkich produktów dostępnych w systemie wraz z ich kategoriami.",
        "responses": {
          "200": {
            "description": "Lista produktów.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer", "example": 1 },
                      "name": { "type": "string", "example": "Chleb" },
                      "category": { "type": "string", "example": "Pieczywo" },
                      "categoryId": { "type": "integer", "example": 10 }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Brak autoryzacji." },
          "500": { "description": "Wewnętrzny błąd serwera." }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthUser": {
        "type": "object",
        "required": ["login", "password"],
        "properties": {
          "login": { "type": "string", "minLength": 3, "example": "jan_kowalski" },
          "password": { "type": "string", "minLength": 8, "format": "password", "example": "moje_bezpieczne_haslo" }
        }
      }
    }
  }
}
