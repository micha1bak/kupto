# Baza danych (kontener `db` w docker-compose). Hasło bez znaków specjalnych URL (@ : / ?),
# bo trafia do DATABASE_URL.
DB_USER=kupto
DB_PASSWORD=
DB_NAME=kupto

# Sekret do podpisywania sesji (JWT) — długi, losowy, np. `openssl rand -hex 32`.
JWT_SECRET=

# true, gdy aplikacja jest serwowana przez HTTPS (zalecane). Ustaw false tylko przy czystym HTTP,
# inaczej przeglądarka nie zapisze ciasteczka sesji i logowanie nie zadziała.
COOKIE_SECURE=true

# Model językowy — dowolny dostawca zgodny z OpenAI Responses API. Domyślnie Groq z modelem
# wybranym na podstawie ewaluacji (zob. backend/README.md). OpenAI: zostaw OPENAI_BASE_URL puste
# i ustaw model OpenAI, np. OPENAI_MODEL=gpt-4.1-mini (nieewaluowany).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# Limit wiadomości do asystenta na użytkownika na godzinę.
CHAT_RATE_LIMIT_PER_HOUR=30

# Powiadomienia Web Push (VAPID) — opcjonalne: puste wyłączają powiadomienia, reszta aplikacji
# działa. Klucze: `cd backend && uv run python -m kupto.push.keys` (zmiana kluczy unieważnia
# subskrypcje urządzeń). Subject: mailto:adres@domena albo https://domena-aplikacji.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
