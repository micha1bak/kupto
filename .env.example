# Baza danych (kontener `db` w docker-compose). Hasło bez znaków specjalnych URL (@ : / ?),
# bo trafia do DATABASE_URL.
DB_USER=kupto
DB_PASSWORD=
DB_NAME=kupto

# Sekret do podpisywania sesji (JWT) — długi, losowy, np. `openssl rand -hex 32`.
JWT_SECRET=

# true, gdy aplikacja jest serwowana przez HTTPS (zalecane). Ustaw false tylko przy czystym HTTP,
# inaczej przeglądarka nie zapisze ciasteczka sesji i logowanie nie zadziała.
COOKIE_SECURE=true

# Model językowy — dowolny dostawca zgodny z OpenAI Responses API.
# OpenAI: zostaw OPENAI_BASE_URL puste. Groq: OPENAI_BASE_URL=https://api.groq.com/openai/v1
# i np. OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

# Limit wiadomości do asystenta na użytkownika na godzinę.
CHAT_RATE_LIMIT_PER_HOUR=30
