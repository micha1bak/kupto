[Unit]
Description=Kupto: zrzut bazy do S3
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=AWS_DEFAULT_REGION=eu-north-1
# Wspólna blokada z kupto-update: wdrożenie nie odtworzy kontenera db w trakcie zrzutu.
ExecStart=/usr/bin/flock /run/kupto.lock /opt/kupto/repo/deploy/kupto-backup.sh
