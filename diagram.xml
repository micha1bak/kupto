<svg xmlns="http://www.w3.org/2000/svg" width="900" height="360" viewBox="0 0 900 360" style="font-family:Segoe UI,Roboto,Arial,sans-serif">
  <defs>
    <marker id="arrow" markerWidth="10" markerHeight="10" refX="10" refY="5" orient="auto">
      <path d="M0 0 L10 5 L0 10 z" fill="#222"/>
    </marker>
    <style>
      .box { fill:#f7f9fb; stroke:#2b7; stroke-width:1; rx:8; }
      .cont { fill:#ffffff; stroke:#1b6; stroke-width:1; rx:8; }
      .text { fill:#111; font-size:13px }
      .small { font-size:11px; fill:#444 }
      .port { font-size:11px; fill:#006; }
    </style>
  </defs>

  <!-- Browser -->
  <g transform="translate(40,30)">
    <rect class="box" x="0" y="0" width="160" height="80"/>
    <text class="text" x="12" y="28">Browser / Frontend</text>
    <text class="small" x="12" y="48">static HTML/JS</text>
  </g>

  <!-- Nginx -->
  <g transform="translate(260,20)">
    <rect class="cont" x="0" y="0" width="220" height="120"/>
    <text class="text" x="12" y="28">nginx (container)</text>
    <text class="small" x="12" y="48">serves /static → reverse-proxy → api</text>
    <text class="port" x="12" y="70">Host:80 → Container:80</text>
    <text class="small" x="12" y="90">volumes: ./public:/usr/share/nginx/html</text>
  </g>

  <!-- FastAPI -->
  <g transform="translate(520,20)">
    <rect class="cont" x="0" y="0" width="220" height="120"/>
    <text class="text" x="12" y="28">FastAPI (container)</text>
    <text class="small" x="12" y="48">uvicorn, /api endpoints (JSON)</text>
    <text class="small" x="12" y="68">env: DATABASE_URL</text>
    <text class="small" x="12" y="88">connects → postgres:5432</text>
  </g>

  <!-- Postgres -->
  <g transform="translate(520,170)">
    <rect class="cont" x="0" y="0" width="220" height="120"/>
    <text class="text" x="12" y="28">Postgres (container)</text>
    <text class="small" x="12" y="48">data volume: db_data:/var/lib/postgresql</text>
    <text class="small" x="12" y="68">ports: 5432 (optional)</text>
  </g>

  <!-- Docker Compose / Network label -->
  <g transform="translate(240,160)">
    <rect x="0" y="0" width="320" height="140" fill="none" stroke="#bbb" rx="6"/>
    <text class="small" x="10" y="18">docker-compose network: services can reach each other by name</text>
  </g>

  <!-- Arrows -->
  <line x1="200" y1="70" x2="260" y2="70" stroke="#222" stroke-width="2" marker-end="url(#arrow)"/>
  <text class="small" x="120" y="58">HTTP</text>

  <line x1="480" y1="70" x2="520" y2="70" stroke="#222" stroke-width="2" marker-end="url(#arrow)"/>
  <text class="small" x="370" y="58">proxy /api</text>

  <line x1="630" y1="140" x2="630" y2="170" stroke="#222" stroke-width="2" marker-end="url(#arrow)"/>
  <text class="small" x="570" y="155">TCP (psql)</text>

  <!-- docker-compose file hint -->
  <g transform="translate(40,150)">
    <rect x="0" y="0" width="160" height="140" fill="#fff6e6" stroke="#e49a00" rx="6"/>
    <text class="small" x="10" y="22">docker-compose.yml</text>
    <text class="small" x="10" y="42">services:</text>
    <text class="small" x="18" y="60">web: image: nginx</text>
    <text class="small" x="18" y="76">  volumes: ./public:/usr/share/nginx/html</text>
    <text class="small" x="18" y="92">api: build: ./backend</text>
    <text class="small" x="18" y="108">db: image: postgres</text>
  </g>

  <!-- Legend -->
  <g transform="translate(40,310)">
    <text class="small">Minimalistyczny stack: Browser → nginx (statics + proxy) → FastAPI → Postgres (volume)</text>
  </g>
</svg>